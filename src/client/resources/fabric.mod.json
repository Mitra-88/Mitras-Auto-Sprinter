{
  "schemaVersion": 1,
  "id": "mitrasautosprinter",
  "version": "${version}",
  "name": "Mitra's Auto Sprinter",
  "description": "Auto-sprint that holds the sprint key for you, with a HUD that tells you why you can't sprint.",
  "contact": {
    "homepage": "https://modrinth.com/mod/mitras-auto-sprinter",
    "sources": "https://github.com/Mitra-88/Mitras-Auto-Sprinter",
    "issues": "https://github.com/Mitra-88/Mitras-Auto-Sprinter/issues"
  },
  "authors": ["Mitra-88"],
  "license": "CC0-1.0",
  "icon": "assets/mitrasautosprinter/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mitra.client.MitrasAutoSprinterClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": ">=${fabric_api_version}",
    "fzzy_config": ">=${fzzy_config_version}"
  },
  "suggests": {
    "modmenu": ">=20.0.3"
  },
  "custom": {
    "modmenu": {
      "links": {
        "github.report_issue": "https://github.com/Mitra-88/Mitras-Auto-Sprinter/issues",
        "modrinth": "https://modrinth.com/mod/mitras-auto-sprinter"
      }
    }
  }
}
